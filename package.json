{
  "name": "inhouse-notes-production",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-wasm.mjs",
    "gen:ui": "node scripts/gen-ui-ids.mjs",
    "test:cargo": "cargo test --manifest-path rust/Cargo.toml --locked --workspace",
    "test:e2e": "playwright test",
    "test:parity": "node tests/v6/parity/run.mjs",
    "test": "npm run test:cargo && npm run test:e2e && npm run test:parity",
    "perf": "node tests/v6/perf/profile.mjs",
    "serve": "node scripts/serve.mjs --root . --overlay build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
